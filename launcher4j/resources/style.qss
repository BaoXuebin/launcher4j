/* Launcher4j Dark Theme */

/* Main Window */
QMainWindow {
    background-color: #1a1d28;
}

QWidget {
    font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 13px;
    color: #e2e6f0;
}

/* Splitter */
QSplitter::handle {
    background-color: #2e3345;
    width: 1px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #4a5365;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #5c687f;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #4a5365;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Sidebar */
#sidebar {
    background-color: #252937;
    border-right: 1px solid #2e3345;
    min-width: 220px;
    max-width: 300px;
}

#sidebar-header {
    padding: 12px 16px;
    border-bottom: 1px solid #2e3345;
}

#sidebar-title {
    font-size: 15px;
    font-weight: 700;
    color: #e2e6f0;
}

#search-input {
    background-color: #2e3345;
    border: 1px solid #3d4355;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e2e6f0;
    font-size: 12px;
    selection-background-color: #2391f7;
}
#search-input:focus {
    border-color: #2391f7;
}

/* Project list item */
#project-item {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 12px;
    margin: 1px 4px;
}
#project-item:hover {
    background-color: #2e3345;
}
#project-item:selected {
    background-color: #2e3345;
    border-color: #2391f7;
}
#project-name {
    font-size: 13px;
    font-weight: 600;
    color: #e2e6f0;
}
#project-name-selected {
    color: #4cb2ff;
}
#project-status-text {
    font-size: 11px;
    color: #7a86a3;
}

/* Buttons */
QPushButton {
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton:hover {
    opacity: 0.9;
}
QPushButton:pressed {
    opacity: 0.8;
}
QPushButton:disabled {
    opacity: 0.4;
}

#btn-primary {
    background-color: #0d73ed;
    color: white;
}
#btn-primary:hover {
    background-color: #2391f7;
}
#btn-primary:pressed {
    background-color: #075bd4;
}

#btn-secondary {
    background-color: #3d4355;
    color: #c8cfe0;
}
#btn-secondary:hover {
    background-color: #4a5365;
}

#btn-ghost {
    background-color: transparent;
    color: #7a86a3;
    padding: 5px 8px;
}
#btn-ghost:hover {
    background-color: #2e3345;
    color: #e2e6f0;
}

#btn-success {
    background-color: rgba(34, 197, 94, 0.2);
    color: #22c55e;
}
#btn-success:hover {
    background-color: rgba(34, 197, 94, 0.3);
}

#btn-danger {
    background-color: rgba(239, 68, 68, 0.2);
    color: #ef4444;
}
#btn-danger:hover {
    background-color: rgba(239, 68, 68, 0.3);
}

#btn-small {
    padding: 4px 12px;
    font-size: 11px;
}

/* Input fields */
QLineEdit, QSpinBox {
    background-color: #2e3345;
    border: 1px solid #3d4355;
    border-radius: 6px;
    padding: 7px 10px;
    color: #e2e6f0;
    font-size: 12px;
    selection-background-color: #2391f7;
}
QLineEdit:focus, QSpinBox:focus {
    border-color: #2391f7;
}

/* Labels */
QLabel#label {
    font-size: 12px;
    font-weight: 600;
    color: #7a86a3;
    margin-bottom: 2px;
}
QLabel#label-help {
    font-size: 11px;
    color: #5c687f;
    margin-top: 2px;
}

/* Log Panel */
#log-panel {
    background-color: #1a1d28;
    border: none;
}

#log-toolbar {
    background-color: #252937;
    border-bottom: 1px solid #2e3345;
    padding: 6px 12px;
}

#log-output {
    background-color: #1a1d28;
    color: #c8cfe0;
    font-family: "JetBrains Mono", "Fira Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
    border: none;
    padding: 12px;
    selection-background-color: #2391f7;
}

/* Status bar */
#statusbar {
    background-color: #252937;
    border-top: 1px solid #2e3345;
    padding: 2px 12px;
    font-size: 11px;
    color: #5c687f;
}

/* Badge indicators */
#badge {
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
}
#badge-success {
    background-color: rgba(34, 197, 94, 0.15);
    color: #22c55e;
}
#badge-warning {
    background-color: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
}
#badge-error {
    background-color: rgba(239, 68, 68, 0.15);
    color: #ef4444;
}
#badge-info {
    background-color: rgba(35, 145, 247, 0.15);
    color: #4cb2ff;
}
#badge-neutral {
    background-color: #3d4355;
    color: #7a86a3;
}

/* Status dot */
#status-dot {
    min-width: 10px;
    min-height: 10px;
    max-width: 10px;
    max-height: 10px;
    border-radius: 5px;
}

/* Dialogs / Modals */
#dialog-overlay {
    background-color: rgba(0, 0, 0, 0.6);
}

#dialog {
    background-color: #252937;
    border: 1px solid #3d4355;
    border-radius: 12px;
}

#dialog-title {
    font-size: 16px;
    font-weight: 700;
    color: #e2e6f0;
    padding: 16px 20px 0;
}

#dialog-content {
    padding: 12px 20px;
}

#dialog-footer {
    padding: 12px 20px;
    border-top: 1px solid #2e3345;
}

/* Checkbox */
QCheckBox {
    color: #c8cfe0;
    font-size: 12px;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #5c687f;
    background-color: #2e3345;
}
QCheckBox::indicator:checked {
    background-color: #2391f7;
    border-color: #2391f7;
}

/* Tooltip */
QToolTip {
    background-color: #252937;
    border: 1px solid #3d4355;
    color: #e2e6f0;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 4px;
}

/* System tray menu */
QMenu {
    background-color: #252937;
    border: 1px solid #3d4355;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 4px;
    color: #e2e6f0;
}
QMenu::item:selected {
    background-color: #2391f7;
    color: white;
}
QMenu::separator {
    height: 1px;
    background-color: #2e3345;
    margin: 4px 8px;
}
